# ─── ОБЯЗАТЕЛЬНО ───

# Steam Web API — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Ключ OpenRouter. Лежит в OPENAI_API_KEY, потому что код ходит через OpenAI SDK
# с baseURL openrouter.ai. Название историческое.
OPENAI_API_KEY=

# Секрет для подписи куки сессии («кто вошёл»). Без него вход не работает,
# а значит и купленное не открывается. Минимум 16 знаков.
# Сгенерировать: openssl rand -hex 24
ACCESS_SECRET=

# ─── TELEGRAM ───

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Канал, подписку на который проверяет бот. Разбора подписка больше НЕ
# открывает — канал остался каналом трафика, доступ решает оплата.
TELEGRAM_CHANNEL_ID=@gamertyper

# Секрет вебхука. ОБЯЗАТЕЛЕН: без него приём событий отключается (503),
# иначе кто угодно смог бы подделать событие с чужим Telegram ID.
TELEGRAM_WEBHOOK_SECRET=

# Имя бота без @ — подставляется в ссылку на гейт, а также в ссылку входа
# t.me/<бот>?start=login. Вшивается в клиентский бандл при сборке,
# менять надо аргумент сборки в docker-compose.override.yml, а не только эту строку.
NEXT_PUBLIC_TELEGRAM_BOT=gamertype_bot

# ─── МОДЕЛИ ───

# Явный выбор поставщика: "openai" (через OpenRouter) или "anthropic" (напрямую).
# Если пусто — берётся openai при наличии OPENAI_API_KEY.
LLM_PROVIDER=openai

# Модель для OpenRouter. Влияет и на портрет, и на перевод.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── ANTHROPIC (LLM_PROVIDER=anthropic) ───

# Ключ из console.anthropic.com — оплата по факту за токены. Это НЕ подписка
# Pro/Max: она подключается отдельно, через мост (см. спеку моста в
# docs/superpowers/specs/). Здесь путь основной для платного ключа и запасной
# для моста: когда мост недоступен, генерация уходит сюда.
ANTHROPIC_API_KEY=

# Цены за миллион токенов (ввод/вывод) на момент настройки:
#   claude-opus-5     $5 / $25   — самая сильная, по умолчанию
#   claude-sonnet-5   $3 / $15   — до 31.08.2026 действует $2 / $10
#   claude-haiku-4-5  $1 / $5    — дешевле всех, НО кеш промпта у неё
#                                  включается только от 4096 токенов,
#                                  так что на нашем промпте не сработает
ANTHROPIC_MODEL=claude-opus-5

# Глубина рассуждений: low | medium | high | xhigh | max.
# Влияет и на качество, и на счёт. medium — разумная отправная точка.
ANTHROPIC_EFFORT=medium

# ─── МОСТ К ПОДПИСКЕ CLAUDE (LLM_PROVIDER=claude-bridge) ───

# Генерация идёт через подписку Claude Max вместо оплаты за токены.
# Мост живёт на ХОСТЕ (не в контейнере), ставится deploy/llm-bridge-setup.sh —
# он же заполняет обе переменные ниже. Руками их править не нужно.
#
# Когда мост недоступен (не отвечает, занят, сессия протухла), генерация
# автоматически уходит на ANTHROPIC_API_KEY, а если его нет — на OpenRouter.
CLAUDE_BRIDGE_ENDPOINT=
CLAUDE_BRIDGE_TOKEN=

# Бюджеты ожидания ВЛОЖЕНЫ друг в друга, а не равны между собой:
#
#   nginx proxy_read_timeout        180000  (снаружи, не в этом репозитории)
#    > CLAUDE_BRIDGE_TOTAL_TIMEOUT_MS 165000  обе попытки моста вместе
#      > CLAUDE_BRIDGE_TIMEOUT_MS     160000  одна попытка
#        > BRIDGE_TIMEOUT_MS          150000  дочерний claude (в /etc/gamertype-llm-bridge.env)
#
# Зачем так. Каждый уровень обязан сдаться раньше внешнего, иначе запрос
# обрывает nginx, и отказ выглядит как «сайт не ответил» — без шанса что-то
# показать посетителю. Внутри окна остаётся 15 секунд форы.
#
# Нижнее значение измерено, и занижать его НЕЛЬЗЯ. История цифр:
#   60000  честная генерация обрывалась на 62-й секунде — всегда мимо;
#   100000 поставили по замеру 77с с запасом 30%, запаса не хватило:
#          боевой аккаунт занял 93,4с, а на повторе перешагнул сотню;
#   150000 текущее (2026-08-11) — 60% запаса к худшему прогону.
#
# Время генерации зависит от размера библиотеки и длины ответа модели,
# поэтому «в среднем столько-то» тут ничего не гарантирует — нужен запас.
#
# Обе переменные заполняет deploy/llm-bridge-setup.sh, руками не нужно.
CLAUDE_BRIDGE_TIMEOUT_MS=160000
CLAUDE_BRIDGE_TOTAL_TIMEOUT_MS=165000

# ─── КАРТИНКИ (Wiro.ai) ───

# Ключ и секрет из кабинета Wiro. Подпись запроса считается из обоих.
WIRO_API_KEY=
WIRO_API_SECRET=

# Модель генерации. Цены за картинку на момент проверки:
#   google/nano-banana-2              $0.010
#   black-forest-labs/flux-1-schnell  $0.006  — самая дешёвая
#   black-forest-labs/flux-2-flex     $0.030
#   bytedance/seedream-v5-lite        $0.020
WIRO_MODEL=google/nano-banana-2

# Отдельный лимит на генерацию картинок: они дороже портретов
ART_RATE_LIMIT_PER_HOUR=10

# ─── АДМИНКА ───

# Пароль входа в /admin и токен для сброса статистики/арта/кеша.
# Он же служит солью для хеширования IP в аналитике: смена пароля
# разрывает связность старых и новых записей.
ADMIN_SECRET=

# ─── НАСТРОЙКИ ───

# Адрес сайта. ВНИМАНИЕ: попадает в клиентский бандл на этапе сборки,
# поэтому задаётся ещё и как build-arg в docker-compose.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Лимит запросов на IP в час
RATE_LIMIT_PER_HOUR=30

# ─── ОПЛАТА ───

# Один переключатель на три положения — он же решает, что показывать:
#   off  — всё бесплатно, кнопки оплаты нет, разбор открыт всем.
#          Значение по умолчанию и сегодняшнее поведение сайта.
#   stub — полный цикл на поддельной кассе: заказ, страница оплаты,
#          вебхук, выдача права. Деньги не списываются. Для отладки.
#   live — боевой эквайер.
# Любое другое значение (и пустое, и с опечаткой) читается как off:
# ошибка в настройке не должна ни начать брать деньги, ни закрыть сайт.
PAYWALL_MODE=off

# Секрет подписи подтверждений от кассы. ОБЯЗАТЕЛЕН при stub и live: без него
# приём подтверждений отключается целиком, иначе кто угодно подделал бы
# «оплачено» и получил разбор даром. Минимум 32 знака.
# Сгенерировать: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# ─── ХРАНИЛИЩА ───

# Upstash Redis. Без него — кеш в памяти + SQLite для того, что должно
# пережить перезапуск (профили, гейт-токены, портреты).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Пути внутри контейнера, заданы в docker-compose
ART_STORAGE_PATH=/data/art
ANALYTICS_DB_PATH=/data/db/analytics.db
